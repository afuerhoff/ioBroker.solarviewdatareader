{
    "type": "tabs",
    "tabsStyle": {
      "width": "calc(100% - 100px)"
    },
    "i18n": true,
    "items": {
      "tab-main": {
        "type": "panel",
        "label": "Main settings",
        "items": {
          "ipaddress": {
            "type": "text",
            "label": "IP-Address",
            "help": "Enter the IP address or hostname of your SolarView data logger.",
            "xs": 12,
            "sm": 6,
            "md": 6,
            "lg": 3,
            "xl": 3
          },
          "port": {
            "type": "port",
            "min": 1,
            "max": 65535,
            "label": "Port",
            "help": "Enter the TCP port used by the data logger (default: 15000).",
            "xs": 12,
            "sm": 6,
            "md": 6,
            "lg": 3,
            "xl": 3
          },
          "intervalVal": {
            "newLine": true,
            "type": "number",
            "label": "polling interval in seconds",
            "help": "Set how often the adapter requests data (10 to 3600 seconds).",
            "min": 10,
            "max": 3600,
            "step": 1,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 3,
            "xl": 3
          },
          "intervalstart": {
            "type": "timePicker",
            "label": "Interval start",
            "help": "Start time for reading inverter data.",
            "format": "HH:mm",
            "returnFormat": "HH:mm:ss",
            "views": ["hours", "minutes"],
            "timeSteps": {"hours": 1, "minutes": 1},
            "xs": 12,
            "sm": 6,
            "md": 6,
            "lg": 3,
            "xl": 3
          },
          "intervalend": {
            "type": "timePicker",
            "label": "Interval end",
            "help": "End time for reading inverter data. Self-consumption and D0 consumption data are still read outside this period.",
            "format": "HH:mm",
            "returnFormat": "HH:mm:ss",
            "views": ["hours", "minutes"],
            "timeSteps": {"hours": 1, "minutes": 1},
            "xs": 12,
            "sm": 6,
            "md": 6,
            "lg": 3,
            "xl": 3
          },
        }
      },
      "tab-devices": {
        "type": "panel",
        "label": "Devices and CCU",
        "items": {
          "d0converter": {
            "type": "checkbox",
            "label": "d0-converter",
            "help": "Enable if a D0 converter is connected.",
            "xs": 12,
            "sm": 6,
            "md": 6,
            "lg": 3,
            "xl": 3
          },
          "scm0": {
            "type": "checkbox",
            "label": "Self consumption meter sum",
            "help": "Enable if SolarView provides the total self-consumption meter.",
            "xs": 12,
            "sm": 6,
            "md": 6,
            "lg": 3,
            "xl": 3
          },
          "scm1": {
            "newLine": true,
            "type": "checkbox",
            "label": "Self consumption meter 1",
            "help": "Enable if the corresponding self-consumption meter is configured in SolarView.",
            "xs": 12,
            "sm": 6,
            "md": 6,
            "lg": 3,
            "xl": 3
          },
          "scm2": {
            "type": "checkbox",
            "label": "Self consumption meter 2",
            "help": "Enable if the corresponding self-consumption meter is configured in SolarView.",
            "xs": 12,
            "sm": 6,
            "md": 6,
            "lg": 3,
            "xl": 3
          },
          "scm3": {
            "type": "checkbox",
            "label": "Self consumption meter 3",
            "help": "Enable if the corresponding self-consumption meter is configured in SolarView.",
            "xs": 12,
            "sm": 6,
            "md": 6,
            "lg": 3,
            "xl": 3
          },
          "scm4": {
            "type": "checkbox",
            "label": "Self consumption meter 4",
            "help": "Enable if the corresponding self-consumption meter is configured in SolarView.",
            "xs": 12,
            "sm": 6,
            "md": 6,
            "lg": 3,
            "xl": 3
          },
          "pvi1": {
            "newLine": true,
            "type": "checkbox",
            "label": "Inverter 1",
            "help": "Enable if the corresponding inverter is configured in SolarView.",
            "xs": 12,
            "sm": 6,
            "md": 6,
            "lg": 3,
            "xl": 3
          },
          "pvi2": {
            "type": "checkbox",
            "label": "Inverter 2",
            "help": "Enable if the corresponding inverter is configured in SolarView.",
            "xs": 12,
            "sm": 6,
            "md": 6,
            "lg": 3,
            "xl": 3
          },
          "pvi3": {
            "type": "checkbox",
            "label": "Inverter 3",
            "help": "Enable if the corresponding inverter is configured in SolarView.",
            "xs": 12,
            "sm": 6,
            "md": 6,
            "lg": 3,
            "xl": 3
          },
          "pvi4": {
            "type": "checkbox",
            "label": "Inverter 4",
            "help": "Enable if the corresponding inverter is configured in SolarView.",
            "xs": 12,
            "sm": 6,
            "md": 6,
            "lg": 3,
            "xl": 3
          },
          "setCCU": {
            "newLine": true,
            "type": "checkbox",
            "label": "Set system variable CCU",
            "help": "Enable to write the current PV power to a Homematic CCU system variable.",
            "xs": 12,
            "sm": 6,
            "md": 6,
            "lg": 3,
            "xl": 3
          },
          "CCUSystemV": {
            "type": "text",
            "label": "System variable",
            "help": "Enter the ioBroker state ID of the CCU variable (e.g. hm-rega.0.12345).",
            "hidden": "!data.setCCU",
            "xs": 12,
            "sm": 6,
            "md": 6,
            "lg": 3,
            "xl": 3
          }
        }
      }
    }
  }